@{
    ViewBag.Title = "Login";
}

<h2>Author Login</h2>

@using (Html.BeginForm())
{
    <div class="form-group">
        <label>Email</label>

        <input type="email"
               name="Email"
               class="form-control"
               required />
    </div>

    <br />

    <div class="form-group">
        <label>Password</label>

        <input type="password"
               name="Author_password"
               class="form-control"
               required />
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Login
    </button>
}

@if (ViewBag.Message != null)
{
    <div class="alert alert-danger">
        @ViewBag.Message
    </div>
}